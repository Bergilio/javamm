package core.ollir.optimization.jmm;

class ConstantPropagationLoop {

    public int loopCounter() {
        int i;
        i = 1;
        while (i < 10) {
            i = i + 1;
        }
        return i;
    }

    public int loopSum() {
        int i;
        int sum;
        i = 0;
        sum = 0;
        while (i < 5) {
            sum = sum + i;
            i = i + 1;
        }
        return sum;
    }

    public int constBeforeLoop() {
        int a;
        int b;
        a = 5;
        b = a + 3;
        while (b < 100) {
            b = b + 1;
        }
        return b;
    }
}
