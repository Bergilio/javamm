package test.core.ollir.statements.jmm;

class NestedWhile {

    public int method(int n) {
        int i;
        int j;
        i = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                j = j + 1;
            }
            i = i + 1;
        }
        return i;
    }
}
