package core.jasmin.statements.jmm;

class JasminStatements {
    public boolean method() {
        int i;
        int a;
        i = 0;

        do {
            i = i + 1;
        } while (i < 5);
        for (a = 0; a < 3; a=a+1) {
            i = i + a;
        }
        if (i == 8) {
            return true;
        }
        return false;
    }
}